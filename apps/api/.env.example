# PadhaiPilot API - Environment Configuration

# Database (PostgreSQL / Neon / Supabase)
DATABASE_URL="postgresql://postgres:password@localhost:5432/padhaipilot?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/padhaipilot?schema=public"

# Authentication Security
JWT_SECRET="padhaipilot-production-secret-key-2026"
PORT=3001
NODE_ENV=development

# Redis (Set to "false" to run 100% in-memory with zero external dependencies)
REDIS_ENABLED="false"
REDIS_RATE_LIMIT_ENABLED="false"

# Optional Upstash Redis / Vercel KV (only when REDIS_ENABLED="true")
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
