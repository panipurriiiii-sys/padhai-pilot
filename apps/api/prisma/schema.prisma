/// Extra faculty assigned to a batch besides Batch.teacherId (the lead teacher).
model BatchFaculty {
  id          String   @id @default(cuid())
  instituteId String
  batchId     String
  facultyId   String
  assignedAt  DateTime @default(now())
  assignedBy  String?

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  batch     Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  faculty   User      @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@unique([batchId, facultyId])
  @@index([instituteId])
  @@index([facultyId, instituteId])
}

/// Student request to correct an attendance record. Reviewed by the batch faculty or management.
model AttendanceCorrectionRequest {
  id           String    @id @default(cuid())
  instituteId  String
  studentId    String
  batchId      String?
  sessionId    String?
  date         DateTime  @db.Date
  reason       String
  status       String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedById String?
  reviewerNote String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  institute Institute          @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student   User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch     Batch?             @relation(fields: [batchId], references: [id], onDelete: SetNull)
  session   AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([instituteId, status])
  @@index([studentId, createdAt])
  @@index([batchId, status])
}

/// Student -> faculty doubt. Replies are rows in AcademicQueryReply.
model AcademicQuery {
  id            String   @id @default(cuid())
  instituteId   String
  studentId     String
  batchId       String?
  facultyId     String? // optional addressee; null = any faculty of the batch
  subject       String
  topic         String?
  questionText  String
  attachmentUrl String?
  status        String   @default("PENDING") // PENDING, ANSWERED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institute Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student   User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch     Batch?               @relation(fields: [batchId], references: [id], onDelete: SetNull)
  replies   AcademicQueryReply[]

  @@index([studentId, createdAt])
  @@index([instituteId, status])
  @@index([batchId, status])
}

model AcademicQueryReply {
  id        String   @id @default(cuid())
  queryId   String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  query AcademicQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@index([queryId, createdAt])
}

/// Personal study planner task. Strictly private to its owner.
model StudyTask {
  id          String    @id @default(cuid())
  instituteId String?
  userId      String
  title       String
  subject     String?
  dueDate     DateTime?
  priority    String    @default("NORMAL") // LOW, NORMAL, HIGH
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  institute Institute? @relation(fields: [instituteId], references: [id], onDelete: SetNull)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isCompleted, dueDate])
}

model SupportRequest {
  id          String   @id @default(cuid())
  instituteId String?
  userId      String
  category    String // PROFILE_CORRECTION, ATTENDANCE_MISMATCH, PAYMENT_ISSUE, ACADEMIC_HELP, TECHNICAL_SUPPORT
  subject     String
  description String
  status      String   @default("SUBMITTED") // SUBMITTED, IN_REVIEW, RESOLVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  institute Institute? @relation(fields: [instituteId], references: [id], onDelete: SetNull)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([instituteId, status])
}

/// Metadata for documents issued to a student (report cards, receipts, certificates). The file bytes
/// live in object storage; only the reference is stored here.
model StudentDocument {
  id             String   @id @default(cuid())
  instituteId    String
  studentId      String
  category       String // REPORT_CARD, FEE_RECEIPT, STUDY_MATERIAL, TIMETABLE_SCHEDULE, CERTIFICATE
  title          String
  academicPeriod String?
  issueDate      DateTime @default(now())
  downloadUrl    String
  fileSize       String?
  issuedById     String?
  createdAt      DateTime @default(now())

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, issueDate])
  @@index([instituteId])
}

/// Faculty invitation (single-use, hashed token). The raw token is shown once to the owner.
model FacultyInvitation {
  id                   String    @id @default(cuid())
  instituteId          String
  email                String
  fullName             String?
  tokenHash            String    @unique // sha256 of the raw token
  role                 Role      @default(FACULTY)
  designation          String
  assignedSubjects     String[]
  batchIds             String[]
  delegatedPermissions String[]
  compensationType     String    @default("FIXED_MONTHLY")
  baseSalary           Float     @default(0)
  hourlyRate           Float     @default(0)
  status               String    @default("PENDING") // PENDING, ACCEPTED, REVOKED
  expiresAt            DateTime
  invitedById          String
  acceptedAt           DateTime?
  acceptedUserId       String?
  revokedAt            DateTime?
  revokedById          String?
  deliveryStatus       String    @default("NOT_SENT") // NOT_SENT, QUEUED, SENT, FAILED
  lastSentAt           DateTime?
  resendCount          Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId, status])
  @@index([instituteId, email])
}

/// Outbound message log / outbox. No provider is wired yet: rows are written as PENDING or SKIPPED so
/// a future provider worker can drain them. `idempotencyKey` makes producers safe to retry.
model NotificationOutbox {
  id             String    @id @default(cuid())
  instituteId    String?
  userId         String?
  channel        String // EMAIL, SMS, WHATSAPP, PUSH
  template       String
  recipient      String
  payload        Json?
  status         String    @default("PENDING") // PENDING, SENT, FAILED, SKIPPED
  idempotencyKey String    @unique
  attempts       Int       @default(0)
  lastError      String?
  createdAt      DateTime  @default(now())
  sentAt         DateTime?

  institute Institute? @relation(fields: [instituteId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([instituteId])
}

/// Test questions with the server-side answer key. NEVER serialised to students.
model TestQuestion {
  id                 String   @id @default(cuid())
  testId             String
  position           Int
  text               String
  type               String   @default("MCQ") // MCQ, TEXT
  options            String[]
  correctOptionIndex Int?
  marks              Float    @default(1)
  negativeMarks      Float    @default(0)

  test    TestQuiz            @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers TestAttemptAnswer[]

  @@unique([testId, position])
  @@index([testId])
}

model TestAttemptAnswer {
  id                  String   @id @default(cuid())
  attemptId           String
  questionId          String
  studentId           String
  selectedOptionIndex Int?
  textAnswer          String?
  isCorrect           Boolean?
  marksAwarded        Float    @default(0)
  createdAt           DateTime @default(now())

  attempt  TestAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question TestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  student  User         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@index([studentId])
}

/// Audit/history row for "promote batch to next class". Enrolment history itself lives on Enrollment
/// (status PROMOTED + endedAt on the source row, promotedFromBatchId on the new row).
model BatchPromotion {
  id             String   @id @default(cuid())
  instituteId    String
  sourceBatchId  String
  targetBatchId  String
  promotedById   String
  movedCount     Int      @default(0)
  skippedCount   Int      @default(0)
  archivedSource Boolean  @default(false)
  createdAt      DateTime @default(now())

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  source    Batch     @relation("PromotionSource", fields: [sourceBatchId], references: [id], onDelete: Cascade)
  target    Batch     @relation("PromotionTarget", fields: [targetBatchId], references: [id], onDelete: Cascade)

  @@index([instituteId, createdAt])
  @@index([sourceBatchId])
  @@index([targetBatchId])
}

model PlatformAnnouncement {
  id             String    @id @default(cuid())
  title          String
  message        String
  severity       String    @default("info") // info, warning, critical
  targetAudience String    @default("ALL") // ALL, TEACHERS, STUDENTS
  expiresAt      DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())

  @@index([createdAt])
}

model PlatformThemeRevision {
  id               String   @id @default(cuid())
  revision         Int      @unique
  revisionId       String   @unique
  checksum         String
  config           Json
  action           String
  restoredFrom     Int?
  previousRevision Int?
  changeSummary    Json?
  reason           String?
  actorId          String
  actorEmail       String
  isActive         Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([isActive])
  @@index([createdAt])
}

// ==========================================================================
// api-finance-docs BLOCK (batch fees, receipts, student leaves). Own migration folder:
// 20261031000400_finance_leaves. instituteId/studentId are plain scoped columns (no FK relation
// declared) so this block does not need back-relations on Institute/User/Batch.
// ==========================================================================

/// Fee plan a teacher/owner sets for a batch. `schedule` = [{ label, amount, dueDate }] (1+ instalments);
/// one StudentFeeRecord per student per instalment is generated from it (and for later enrolments).
model BatchFeeStructure {
  id           String    @id @default(cuid())
  instituteId  String
  batchId      String
  title        String
  academicYear String?
  schedule     Json
  status       String    @default("ACTIVE") // ACTIVE, VOID
  createdById  String
  voidedAt     DateTime?
  voidReason   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  records StudentFeeRecord[]

  @@index([instituteId, batchId])
  @@index([batchId, status])
}

/// A manually recorded payment. Immutable once issued: corrections are done by voiding (status +
/// reason + actor) and recording a new payment; the receipt number is never reused or edited.
model FeePayment {
  id            String    @id @default(cuid())
  instituteId   String
  feeRecordId   String
  studentId     String
  amount        Float
  paidOn        DateTime
  mode          String // CASH, UPI, BANK_TRANSFER, CHEQUE, CARD, OTHER
  reference     String?
  note          String?
  receiptNumber String
  status        String    @default("ISSUED") // ISSUED, VOIDED
  recordedById  String
  voidedAt      DateTime?
  voidedById    String?
  voidReason    String?
  createdAt     DateTime  @default(now())

  feeRecord StudentFeeRecord @relation(fields: [feeRecordId], references: [id], onDelete: Cascade)

  @@unique([instituteId, receiptNumber])
  @@index([feeRecordId])
  @@index([studentId, createdAt])
  @@index([instituteId, paidOn])
}

/// Per-institute counters (receipt numbers). Incremented atomically inside the payment transaction.
model InstituteCounter {
  instituteId String
  key         String
  value       Int    @default(0)

  @@id([instituteId, key])
}

model StudentLeaveApplication {
  id              String    @id @default(cuid())
  instituteId     String
  studentId       String
  batchId         String?
  startDate       DateTime  @db.Date
  endDate         DateTime  @db.Date
  totalDays       Int       @default(1)
  reason          String
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  reviewedById    String?
  reviewerRemarks String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([instituteId, status])
  @@index([studentId, createdAt])
  @@index([batchId, status])
}
