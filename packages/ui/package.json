{
  "name": "@padhai-pilot/ui",
  "version": "0.1.0",
  "private": true,
  "description": "PadhaiPilot premium component + motion ecosystem (web). Source-distributed; apps transpile it.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./motion": "./src/motion/index.ts",
    "./styles.css": "./src/styles/pp.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@padhai-pilot/assets": "*",
    "motion": "^14.9.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
