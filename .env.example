# PadhaiPilot — Environment Variables Reference
# DO NOT COMMIT SECRETS TO SOURCE CONTROL

# -------------------------------------------------------------
# DATABASE (PostgreSQL - Pooled for Serverless, Direct for Migrations)
# -------------------------------------------------------------
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@your-db-host.com:6543/padhaipilot?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@your-db-host.com:5432/padhaipilot"

# -------------------------------------------------------------
# UPSTASH REDIS / VERCEL KV (REST-Based Serverless Cache & Rate Limiter)
# Free Tier: 10,000 commands/day — Cost: $0/month
# -------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-rest-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"
REDIS_CACHE_ENABLED="true"
REDIS_RATE_LIMIT_ENABLED="true"
REDIS_FAIL_CLOSED_AUTH="false"
REDIS_TIMEOUT_MS="3000"

# -------------------------------------------------------------
# AUTHENTICATION & TOKENS
# -------------------------------------------------------------
# Required in production, >= 32 chars (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))").
# The API refuses to start in production without it, and rejects the value that was once hard-coded in the repo.
JWT_SECRET="generate-a-secure-random-64-character-secret-for-production"
JWT_EXPIRES_IN="12h"

# Platform Owner bootstrap (one-time, run locally against the target DB; never commit real values):
#   npm run build:api && npm run bootstrap:admin --workspace=@padhai-pilot/api
# SUPER_ADMIN_EMAIL=""
# SUPER_ADMIN_PASSWORD=""   # >= 12 characters
# SUPER_ADMIN_NAME="Platform Owner"

# -------------------------------------------------------------
# API & WEB SERVICE URLS
# -------------------------------------------------------------
PORT=3001
API_BASE_URL="http://localhost:3001/api"
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# CORS Allowed Origins (comma separated, exact origins). In production anything not listed is rejected.
CORS_ORIGINS="http://localhost:3000,http://localhost:3002,https://teacher.padhaipilot.com,https://admin.padhaipilot.com"
